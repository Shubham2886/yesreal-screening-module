# copy this to .env and fill in real values

PORT=5000
NODE_ENV=development

# postgres
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=yesreal_screening

# jwt
JWT_SECRET=change_this_to_something_long_and_random
JWT_EXPIRES_IN=8h

# AI provider config
# AI_MODE options: mock | openai | groq
# i keep in "mock" unless i actually have a key, mock mode is fully deterministic
AI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# local storage acting as our S3 abstraction
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads

# if STORAGE_DRIVER=s3, fill these in and swap the driver in storageService.js
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# cron
REPROCESS_CRON=0 3 * * *
